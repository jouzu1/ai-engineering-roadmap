# Salin file ini menjadi ".env" lalu isi nilainya sesuai kebutuhan lokal Anda.
# Contoh:
#   Windows PowerShell:   copy .env.example .env
#   Linux/macOS:          cp .env.example .env

# =============== LLM / RAG ===============
# Pilih salah satu: gunakan OpenAI ATAU model lokal (Ollama).

# Jika gunakan OpenAI:
OPENAI_API_KEY=isi_dengan_api_key_anda

# Jika gunakan Ollama (model lokal):
# Install Ollama: https://ollama.ai
# Jalankan server lokal (default): http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# Nama model contoh (unduh dengan `ollama pull mistral` atau `ollama pull llama3`):
OLLAMA_MODEL=mistral

# Pengaturan umum RAG
# Lokasi penyimpanan vectorstore (FAISS)
VECTORSTORE_PATH=.cache/vectorstore
# Model embedding default (OpenAI)
EMBEDDING_MODEL=text-embedding-3-small
# Alternatif lokal (jika pakai sentence-transformers + langchain komunitas)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============== FASTAPI ===============
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# =============== STREAMLIT (opsional) ===============
STREAMLIT_SERVER_PORT=8501

# =============== MLflow ===============
# Jalankan UI lokal: `mlflow ui --port 5000`
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=default

# =============== DVC (opsional) ===============
# Contoh remote (isi sesuai storage Anda). Biarkan kosong jika belum digunakan.
DVC_REMOTE_NAME=origin
DVC_REMOTE_URL=

# =============== DATABASE (opsional) ===============
# Jika Anda ingin menyimpan log atau metadata ke DB.
DB_URL=

# =============== KEAMANAN ===============
# Jangan commit file .env yang berisi data sensitif ke repository publik.
# Gunakan file .env.example ini untuk berbagi struktur variabel tanpa rahasia.
